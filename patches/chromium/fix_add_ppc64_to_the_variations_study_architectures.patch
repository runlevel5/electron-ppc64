From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Pearson <tpearson@raptorengineering.com>
Date: Thu, 19 Nov 2026 09:33:59 +1100
Subject: fix: add ppc64 to the variations study architectures

Without a ppc64 value the variations service crashes on startup.

Origin: Debian chromium packaging, debian/patches/ppc64le/fixes/fix-study-crash.patch (156.0.8078.79-1).

diff --git a/components/variations/proto/study.proto b/components/variations/proto/study.proto
index debaa8a3e8d6742895302382de7708e8656226d0..10cb2ee58a8f282f7fce139aa12fdeb6b83d70d6 100644
--- a/components/variations/proto/study.proto
+++ b/components/variations/proto/study.proto
@@ -300,6 +300,9 @@ message Study {
     // A Mac-only value, indicating an x86-64 binary running on an arm64 host
     // via "Rosetta 2" binary translation.
     TRANSLATED_X86_64 = 4;
+
+    // A POSIX-only value, indicating an OpenPOWER host
+    PPC64 = 5;
   }
 
   // Possible states of the policy restriction filter.
diff --git a/components/variations/service/variations_field_trial_creator.cc b/components/variations/service/variations_field_trial_creator.cc
index 42f411cf23644415502269725f4e10f72a5be36a..0af01053d86d76977ec46b68245386c417e00806 100644
--- a/components/variations/service/variations_field_trial_creator.cc
+++ b/components/variations/service/variations_field_trial_creator.cc
@@ -108,6 +108,9 @@ Study::CpuArchitecture GetCurrentCpuArchitecture() {
   if (process_arch == "x86") {
     return Study::X86_32;
   }
+  if (process_arch == "PPC_64") {
+    return Study::PPC64;
+  }
   if (process_arch == "x86_64") {
     std::string os_arch = base::SysInfo::OperatingSystemArchitecture();
     if (base::StartsWith(os_arch, "arm",
