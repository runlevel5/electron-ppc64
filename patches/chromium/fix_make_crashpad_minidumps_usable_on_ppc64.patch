   EXPECT_EQ(observed->vregs.save_vscr.lo, expected.vregs.save_vscr.lo);
   EXPECT_EQ(observed->vregs.save_vscr.hi, expected.vregs.save_vscr.hi);
-  EXPECT_EQ(observed->vregs.save_vrsave, expected.vregs.save_vrsave);
