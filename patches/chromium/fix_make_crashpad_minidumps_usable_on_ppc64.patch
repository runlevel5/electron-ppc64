From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Thu, 19 Nov 2026 09:33:59 +1100
Subject: fix: make crashpad minidumps usable on ppc64

The crashpad handler aborted on a NOTREACHED while writing a minidump
because MinidumpSystemInfoWriter had no PPC64 case, leaving 0-byte dumps.

MinidumpContextPPC64 did not match Breakpad's MDRawContextPPC64, so
minidump processors could not read thread contexts. Give it the same
layout.

Also add ppc64 to the minidump reader and repair the ppc64 unit tests,
which no longer compiled.

diff --git a/third_party/crashpad/crashpad/minidump/minidump_context.h b/third_party/crashpad/crashpad/minidump/minidump_context.h
index e65180bece81e11dd108926dd604fb21806f9416..27790454a86734bc7df119b1c80e077e604c0d15 100644
--- a/third_party/crashpad/crashpad/minidump/minidump_context.h
+++ b/third_party/crashpad/crashpad/minidump/minidump_context.h
@@ -714,7 +714,10 @@ enum MinidumpContextPPC64Flags : uint32_t {
 };
 
 //! \brief A PPC64 CPU context carried in a minidump file.
-//! Based on minidump_cpu_ppc64.h from breakpad.
+//!
+//! This structure must stay layout-compatible with Breakpad's
+//! `MDRawContextPPC64` (minidump_cpu_ppc64.h), which is what minidump
+//! processors use to recognize and read the context.
 struct MinidumpContextPPC64 {
   uint64_t context_flags;
 
@@ -727,11 +730,17 @@ struct MinidumpContextPPC64 {
   uint64_t lnk;
   uint64_t ctr;
 
+  //! \brief VRSAVE register.
+  uint64_t vrsave;
+
   //! \brief Floating point registers.
   double fpregs[32];
 
+  //! \brief Padding included for breakpad compatibility.
+  uint32_t fpscr_pad;
+
   //! \brief FPU status register.
-  double fpscr;
+  uint32_t fpscr;
 
   //! \brief Altivec/VMX vector registers.
   struct {
@@ -742,8 +751,8 @@ struct MinidumpContextPPC64 {
       //! \brief Padding included for breakpad compatibiltiy.
       uint32_t save_pad5[4];
 
-      //! \brief VRSAVE register.
-      uint32_t save_vrsave;
+      //! \brief Bitmask of the vector registers that are saved.
+      uint32_t save_vrvalid;
 
       //! \brief Padding included for breakpad compatibiltiy.
       uint32_t save_pad6[7];
diff --git a/third_party/crashpad/crashpad/minidump/minidump_context_writer.cc b/third_party/crashpad/crashpad/minidump/minidump_context_writer.cc
index 3ce24a24cd83f7624f8deb68167d9041387d634a..cccd1816b23a5c1e279269215e352d2b3d269dcf 100644
--- a/third_party/crashpad/crashpad/minidump/minidump_context_writer.cc
+++ b/third_party/crashpad/crashpad/minidump/minidump_context_writer.cc
@@ -613,6 +613,9 @@ size_t MinidumpContextRISCV64Writer::ContextSize() const {
   return sizeof(context_);
 }
 
+static_assert(sizeof(MinidumpContextPPC64) == 1160,
+              "must match Breakpad's MDRawContextPPC64");
+
 MinidumpContextPPC64Writer::MinidumpContextPPC64Writer()
   : MinidumpContextWriter(), context_() {
     context_.context_flags = kMinidumpContextPPC64;
@@ -636,13 +639,17 @@ void MinidumpContextPPC64Writer::InitializeFromSnapshot(
   context_.ctr = context_snapshot->ctr;
 
   memcpy(context_.fpregs, context_snapshot->fpregs, sizeof(context_.fpregs));
-  context_.fpscr = context_snapshot->fpscr;
+  // The snapshot carries FPSCR as the raw 64-bit register image.
+  uint64_t fpscr;
+  memcpy(&fpscr, &context_snapshot->fpscr, sizeof(fpscr));
+  context_.fpscr = static_cast<uint32_t>(fpscr);
 
   memcpy(context_.vregs.save_vr, context_snapshot->vregs.save_vr,
          sizeof(context_.vregs.save_vr));
   memcpy(&context_.vregs.save_vscr, &context_snapshot->vregs.save_vscr,
          sizeof(context_.vregs.save_vscr));
-  context_.vregs.save_vrsave = context_snapshot->vregs.save_vrsave;
+  context_.vregs.save_vrvalid = 0xffffffff;
+  context_.vrsave = context_snapshot->vregs.save_vrsave;
 }
 
 bool MinidumpContextPPC64Writer::WriteObject(
