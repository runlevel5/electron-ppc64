diff --git a/third_party/crashpad/crashpad/minidump/test/minidump_context_test_util.cc b/third_party/crashpad/crashpad/minidump/test/minidump_context_test_util.cc
index db380631e4142478f4cf8d20ada040d179d31da1..1ec5001d3c35badbc4762ea7acad1f41768b88a2 100644
--- a/third_party/crashpad/crashpad/minidump/test/minidump_context_test_util.cc
+++ b/third_party/crashpad/crashpad/minidump/test/minidump_context_test_util.cc
@@ -308,7 +308,7 @@ void InitializeMinidumpContextPPC64(MinidumpContextPPC64* context,
   context->context_flags = kMinidumpContextPPC64All;
 
   uint64_t value = seed;
-  for (size_t i = 0; i < base::size(context->regs); ++i) {
+  for (size_t i = 0; i < std::size(context->regs); ++i) {
     context->regs[i] = value++;
   }
 
@@ -319,16 +319,23 @@ void InitializeMinidumpContextPPC64(MinidumpContextPPC64* context,
   context->lnk = value++;
   context->ctr = value++;
 
-  for (size_t i = 0; i < base::size(context->fpregs); ++i) {
+  for (size_t i = 0; i < std::size(context->fpregs); ++i) {
     context->fpregs[i] = static_cast<double>(i);
   }
-  context->fpscr = value++;
+  // Mirrors InitializeCPUContextPPC64(), which stores the seed-derived value
+  // as a double; the writer keeps the low half of its raw image.
+  double fpscr_double = static_cast<double>(value++);
+  uint64_t fpscr;
+  memcpy(&fpscr, &fpscr_double, sizeof(fpscr));
+  context->fpscr_pad = 0;
+  context->fpscr = static_cast<uint32_t>(fpscr);
 
-  for (size_t i = 0; i < base::size(context->vregs.save_vr); ++i) {
+  for (size_t i = 0; i < std::size(context->vregs.save_vr); ++i) {
     context->vregs.save_vr[i] = {value++, value++};
   }
   context->vregs.save_vscr = {value++, value++};
-  context->vregs.save_vrsave = value++;
+  context->vregs.save_vrvalid = 0xffffffff;
+  context->vrsave = static_cast<uint32_t>(value++);
 }
 
 namespace {
@@ -687,7 +694,7 @@ void ExpectMinidumpContextPPC64(uint32_t expect_seed,
 
   EXPECT_EQ(observed->context_flags, expected.context_flags);
 
-  for (size_t i = 0; i < base::size(expected.regs); ++i) {
+  for (size_t i = 0; i < std::size(expected.regs); ++i) {
     EXPECT_EQ(observed->regs[i], expected.regs[i]);
   }
 
@@ -698,18 +705,19 @@ void ExpectMinidumpContextPPC64(uint32_t expect_seed,
   EXPECT_EQ(observed->lnk, expected.lnk);
   EXPECT_EQ(observed->ctr, expected.ctr);
 
-  for (size_t i = 0; i < base::size(expected.fpregs); ++i) {
