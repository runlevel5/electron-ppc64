diff --git a/third_party/crashpad/crashpad/snapshot/minidump/minidump_context_converter.cc b/third_party/crashpad/crashpad/snapshot/minidump/minidump_context_converter.cc
index ec02dff1266785d98dc119a9cfa9e3980a02d84f..98bdac83eefaf4ca04f6052566945a452bd10d3d 100644
--- a/third_party/crashpad/crashpad/snapshot/minidump/minidump_context_converter.cc
+++ b/third_party/crashpad/crashpad/snapshot/minidump/minidump_context_converter.cc
@@ -266,6 +266,46 @@ bool MinidumpContextConverter::Initialize(
     context_.mips64->fir = src->fir;
 
     memcpy(&context_.mips64->fpregs, &src->fpregs, sizeof(src->fpregs));
+  } else if (context_.architecture == CPUArchitecture::kCPUArchitecturePPC64) {
+    context_memory_.resize(sizeof(CPUContextPPC64));
+    context_.ppc64 = reinterpret_cast<CPUContextPPC64*>(context_memory_.data());
+    const MinidumpContextPPC64* src =
+        reinterpret_cast<const MinidumpContextPPC64*>(minidump_context.data());
+    if (minidump_context.size() < sizeof(MinidumpContextPPC64)) {
+      return false;
+    }
+
+    if (!(src->context_flags & kMinidumpContextPPC64)) {
+      return false;
+    }
+
+    context_.ppc64->nip = src->nip;
+    context_.ppc64->msr = src->msr;
+    context_.ppc64->ccr = src->ccr;
+    context_.ppc64->xer = src->xer;
+    context_.ppc64->lnk = src->lnk;
+    context_.ppc64->ctr = src->ctr;
+
+    static_assert(sizeof(context_.ppc64->regs) == sizeof(src->regs),
+                  "GPR size mismatch");
+    memcpy(&context_.ppc64->regs, &src->regs, sizeof(src->regs));
+
+    static_assert(sizeof(context_.ppc64->fpregs) == sizeof(src->fpregs),
+                  "FPR size mismatch");
+    memcpy(&context_.ppc64->fpregs, &src->fpregs, sizeof(src->fpregs));
+
+    // The snapshot carries FPSCR as the raw 64-bit register image.
+    const uint64_t fpscr = src->fpscr;
+    memcpy(&context_.ppc64->fpscr, &fpscr, sizeof(fpscr));
+
+    static_assert(sizeof(context_.ppc64->vregs.save_vr) ==
+                      sizeof(src->vregs.save_vr),
+                  "VR size mismatch");
+    memcpy(&context_.ppc64->vregs.save_vr,
+           &src->vregs.save_vr,
+           sizeof(src->vregs.save_vr));
+    context_.ppc64->vregs.save_vscr = src->vregs.save_vscr;
+    context_.ppc64->vregs.save_vrsave = static_cast<uint32_t>(src->vrsave);
   } else if (context_.architecture ==
              CPUArchitecture::kCPUArchitectureRISCV64) {
     context_memory_.resize(sizeof(CPUContextRISCV64));
