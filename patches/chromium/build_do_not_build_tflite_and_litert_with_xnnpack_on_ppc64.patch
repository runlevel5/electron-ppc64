From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Thu, 19 Nov 2026 09:33:59 +1100
Subject: build: do not build tflite and litert with XNNPACK on ppc64

XNNPACK has no generated build files for ppc64. Fall back to the
reference kernels, as 32-bit arm already does.

diff --git a/third_party/litert/features.gni b/third_party/litert/features.gni
index cee24ffee0dc225a605079d5db490851418abbe0..556416ea767ea6197f12cd4c288486ff7ee50054 100644
--- a/third_party/litert/features.gni
+++ b/third_party/litert/features.gni
@@ -4,5 +4,6 @@
 
 declare_args() {
   # This enables building LiteRT with XNNPACK.
-  build_litert_with_xnnpack = current_cpu != "arm" && !is_fuchsia
+  build_litert_with_xnnpack =
+      current_cpu != "arm" && current_cpu != "ppc64" && !is_fuchsia
 }
diff --git a/third_party/tflite/features.gni b/third_party/tflite/features.gni
index 36202850d17bd4e6c9cfe0c892f34fd4aae7eb27..567793d0d9517b18cf04b67a3263165b04d0a96a 100644
--- a/third_party/tflite/features.gni
+++ b/third_party/tflite/features.gni
@@ -15,7 +15,8 @@ declare_args() {
   use_litert_tflite = false
 
   # This enables building TFLite with XNNPACK.
-  build_tflite_with_xnnpack = current_cpu != "arm" && !is_fuchsia
+  build_tflite_with_xnnpack =
+      current_cpu != "arm" && current_cpu != "ppc64" && !is_fuchsia
 
   # Turns on TFLITE_WITH_RUY, using ruy as the gemm backend instead of gemmlowp.
   build_tflite_with_ruy = true
