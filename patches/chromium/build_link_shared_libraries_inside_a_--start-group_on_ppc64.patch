From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Pearson <tpearson@raptorengineering.com>
Date: Thu, 19 Nov 2026 09:33:59 +1100
Subject: build: link shared libraries inside a --start-group on ppc64

Works around linker failures caused by Rust libraries combined with
whole-archive linking.

Origin: Debian chromium packaging, debian/patches/ppc64le/fixes/fix-rust-linking.patch (156.0.8078.79-1).

diff --git a/build/toolchain/gcc_toolchain.gni b/build/toolchain/gcc_toolchain.gni
index 612864d0dc5732f4aae74c35f7ac69e5cf7c9a97..3ce03f15224f01ee56126093b7ca2f49fe6a1bf2 100644
--- a/build/toolchain/gcc_toolchain.gni
+++ b/build/toolchain/gcc_toolchain.gni
@@ -464,13 +464,25 @@ template("single_gcc_toolchain") {
       } else {
         main_so_file = sofile_with_symbols
       }
-      link_command = "$ld -shared $soname_flag {{ldflags}}${extra_ldflags} -o \"$main_so_file\" "
+      if (target_cpu == "ppc64") {
+        # Work around linker failures due to Rust libraries and the use of whole-archive
+        link_command = "$ld -shared $soname_flag -Wl,--start-group {{ldflags}}${extra_ldflags} -o \"$main_so_file\" "
+      }
+      else {
+        link_command = "$ld -shared $soname_flag {{ldflags}}${extra_ldflags} -o \"$main_so_file\" "
+      }
 
       if (use_mold_separate_debug_file) {
         # TODO(40208899): See if it adding --detach for local builds helps.
         link_command += "\"-Wl,--separate-debug-file=$sofile_with_symbols\" -Wl,--no-detach "
       }
-      link_command += "@\"$rspfile\" {{rlibs}}"
+      if (target_cpu == "ppc64") {
+        # Work around linker failures due to Rust libraries and the use of whole-archiv
+        link_command += "@\"$rspfile\" {{rlibs}}  -Wl,--end-group"
+      }
+      else {
+        link_command += "@\"$rspfile\" {{rlibs}}"
+      }
 
       # Generate a map file to be used for binary size analysis.
       # Map file adds ~10% to the link time on a z620.
@@ -582,13 +594,25 @@ template("single_gcc_toolchain") {
       } else {
         main_so_file = sofile_with_symbols
       }
-      link_command = "$ld -shared $soname_flag {{ldflags}}${extra_ldflags} -o \"$main_so_file\" "
+      if (target_cpu == "ppc64") {
+        # Work around linker failures due to Rust libraries and the use of whole-archive
+        link_command = "$ld -shared -Wl,--start-group $soname_flag {{ldflags}}${extra_ldflags} -o \"$main_so_file\" "
+      }
+      else {
+        link_command = "$ld -shared $soname_flag {{ldflags}}${extra_ldflags} -o \"$main_so_file\" "
+      }
 
       if (use_mold_separate_debug_file) {
         # TODO(40208899): See if it adding --detach for local builds helps.
         link_command += "\"-Wl,--separate-debug-file=$sofile_with_symbols\" -Wl,--no-detach "
       }
-      link_command += "@\"$rspfile\" {{rlibs}}"
+      if (target_cpu == "ppc64") {
+        # Work around linker failures due to Rust libraries and the use of whole-archive
+        link_command += "@\"$rspfile\" -Wl,--end-group {{rlibs}}"
+      }
+      else {
+        link_command += "@\"$rspfile\" {{rlibs}}"
+      }
 
       # Generate a map file to be used for binary size analysis.
       # Map file adds ~10% to the link time on a z620.
