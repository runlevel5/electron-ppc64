Date: Thu, 19 Nov 2026 09:33:59 +1100
Subject: build: recognize ppc64le as a 64-bit target

BoringSSL has no ppc64le entry in its target list. Add one so the
portable C implementations build.

diff --git a/include/openssl/target.h b/include/openssl/target.h
index 2372a055d049fb4b08246a0007a2eec8964a027a..c77ba140b53d07d9e21c3ad16ce8e5d3036e3fea 100644
--- a/include/openssl/target.h
+++ b/include/openssl/target.h
@@ -34,6 +34,8 @@
 #elif defined(__ARMEL__) || defined(_M_ARM)
 #define OPENSSL_32_BIT
 #define OPENSSL_ARM
+#elif defined(__powerpc64__) && defined(__LITTLE_ENDIAN__)
+#define OPENSSL_64_BIT
 #elif defined(__MIPSEL__) && !defined(__LP64__)
 #define OPENSSL_32_BIT
 #define OPENSSL_MIPS
